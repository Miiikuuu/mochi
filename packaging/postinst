#!/bin/sh
set -eu
# Alternate-root package tests must never restart the host user services.
[ -z "${DPKG_ROOT:-}" ] || exit 0
if [ "$1" = configure ]; then
  if command -v loginctl >/dev/null 2>&1; then
    loginctl list-users --no-legend 2>/dev/null | while read -r uid name rest; do
      [ -S "/run/user/$uid/bus" ] || continue
      runuser -u "$name" -- env XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" sh -c 'systemctl --user daemon-reload; systemctl --user start mochi-sessiond.socket; systemctl --user try-restart mochi-sessiond.service; if systemctl --user is-active --quiet mochi-chatgpt-mcp.service; then systemctl --user kill --kill-whom=main --signal=SIGHUP mochi-chatgpt-mcp.service; fi' || true
    done
  fi
fi
