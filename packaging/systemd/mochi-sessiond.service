[Unit]
Description=Mochi conversation session service
Requires=mochi-sessiond.socket
After=mochi-sessiond.socket

[Service]
Type=simple
ExecStart=/usr/bin/python3 -B /usr/libexec/mochi/platform/linux/sessiond.py
RuntimeDirectory=mochi
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
# Trusted GUI children outlive service replacement; each loses old authority.
KillMode=process
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mochi-sessiond
